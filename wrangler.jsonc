// Configuración del Worker de Cloudflare que publica la web.
// "name" tiene que coincidir con el nombre del Worker en Cloudflare (csconfig).
{
  "name": "csconfig",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    // Estas páginas pasan por worker.js para añadirles la imagen de vista previa (og:image)
    "run_worker_first": ["/", "/cambios*", "/conversor*", "/enviar*"]
  },
  "observability": { "enabled": true }
}
